---
/**
 * Static shell for the paper-page commenting UI.
 *
 * Markup only — every slot that will ever hold visitor-supplied text (comment
 * bodies, author names, quotes) is EMPTY here and is filled by the controller
 * with `textContent`. Nothing in this file interpolates data, so nothing in it
 * can inject markup.
 *
 * The whole shell renders `hidden`: with `PUBLIC_COMMENTS_WORKER` unset the
 * controller returns immediately and the paper page looks and behaves exactly
 * as it did before commenting existed.
 *
 * Placed as the last child of `<article class="paper">`, which is the rail's
 * positioning context: wide viewports float the rail in the right margin, and
 * below the breakpoint it simply flows under the paper (see comments.css).
 */
---

<div class="cs-comments" id="cs-comments" hidden>
  <aside class="cs-rail" id="cs-rail" aria-label="Reader commentary">
    <div class="cs-rail-head">
      Reader commentary
      <span class="cs-rail-count" id="cs-rail-count"></span>
    </div>
    <div class="cs-rail-cards" id="cs-rail-cards"></div>
    <div class="cs-rail-general" id="cs-rail-general"></div>
    <p class="cs-rail-empty" id="cs-rail-empty">
      No comments yet — select a passage to leave one.
    </p>
  </aside>

  <details class="cs-archived" id="cs-archived" hidden>
    <summary id="cs-archived-summary">Comments on earlier versions</summary>
    <div class="cs-abody" id="cs-archived-list"></div>
  </details>

  <button class="cs-selbtn" id="cs-selbtn" type="button" hidden>💬 Comment</button>

  <div
    class="cs-composer"
    id="cs-composer"
    role="dialog"
    aria-label="Write a comment on this passage"
    hidden
  >
    <p class="cs-anchor-line">
      Anchored to: <em id="cs-quote"></em>
      <span class="cs-snap" id="cs-snap"></span>
    </p>
    <div class="cs-seg" id="cs-seg" role="group" aria-label="Comment tag">
      <button type="button" class="cs-t-none is-on" data-tag="none" aria-pressed="true">
        💬 Comment
      </button>
      <button type="button" class="cs-t-verified" data-tag="verified" aria-pressed="false">
        ✅ Verified
      </button>
      <button type="button" class="cs-t-problem" data-tag="problem" aria-pressed="false">
        ⚠️ Problem
      </button>
    </div>
    <p class="cs-tagnote" id="cs-tagnote"></p>
    <label class="cs-sr-only" for="cs-text">Your comment</label>
    <textarea id="cs-text" maxlength="10000" placeholder="Write your comment…"></textarea>
    <p class="cs-counter" id="cs-counter"></p>
    <p class="cs-status" id="cs-status"></p>
    <p class="cs-signin-note" id="cs-signin-note">
      Signing in only confirms who you are — it grants no access to your
      repositories, and your comment is posted for you by this site.
    </p>
    <div class="cs-foot">
      <span class="cs-idchip" id="cs-idchip" hidden></span>
      <button class="cs-signin" id="cs-signin" type="button">Sign in with GitHub</button>
      <span class="cs-grow"></span>
      <button class="cs-cancel" id="cs-cancel" type="button">Cancel</button>
      <button class="cs-post" id="cs-post" type="button">Post</button>
    </div>
  </div>
</div>
