{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,130p' CausalSmith/Stat/STAT_ReverseklTwoCoverage_Research/Localization/Concentration.lean\nsed -n '400,500p' CausalSmith/Stat/STAT_ReverseklTwoCoverage_Research/Localization/Concentration.lean\nsed -n '1,260p' CausalSmith/Stat/STAT_ReverseklTwoCoverage_Research/Learner/PredictionPolytope.lean\"","aggregated_output":"/-\n# Prediction-space learners\n\nThe construction is deliberately coordinate-free: selection happens among\nprediction functions, never among coefficient representatives.\n-/\n\nimport CausalSmith.Stat.STAT_ReverseklTwoCoverage_Research.Basic\nimport Causalean.Stat.Concentration.Covering.CoveringNumber\nimport Mathlib.LinearAlgebra.Matrix.NonsingularInverse\n\nset_option linter.unusedDecidableInType false\nset_option linter.unusedFintypeInType false\nset_option linter.unusedVariables false\n\nnamespace CausalSmith.Stat.ReverseKLTwoCoverage\n\nopen scoped BigOperators\n\nvariable {d n : ℕ} {𝒳 𝒜 : Type*}\n  [Fintype 𝒳] [Fintype 𝒜] [DecidableEq 𝒳] [DecidableEq 𝒜]\n  [LinearOrder 𝒳] [LinearOrder 𝒜]\n  [MeasurableSpace 𝒳] [MeasurableSpace 𝒜]\n  [MeasurableSingletonClass 𝒳] [MeasurableSingletonClass 𝒜]\n  (E : CommonExperiment d 𝒳 𝒜)\n\nabbrev Prediction := 𝒳 → 𝒜 → ℝ\n\n/-- Bounded linear prediction polytope. -/\ndef predictionPolytope : Set (Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)) :=\n  {f | (∀ x a, f x a ∈ Set.Icc (0 : ℝ) 1) ∧\n    ∃ θ : Fin d → ℝ, ∀ x a, f x a = ∑ i, E.feature x a i * θ i}\n  -- @realizes \\mathcal F({bounded linear predictions in [0,1]^S})\n\n/-- Empirical squared loss. -/\nnoncomputable def empiricalLoss (sample : LoggedSample n 𝒳 𝒜)\n    (f : Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)) : ℝ :=\n  (n : ℝ)⁻¹ * ∑ i, ((sample i).reward - f (sample i).context (sample i).action) ^ 2\n  -- @realizes L_n(n⁻¹∑(Y_i-f(X_i,A_i))²)\n\n/-- The fixed sequential total order on context-action coordinates: contexts\nare compared first, and actions break ties between equal contexts. -/\ndef PredictionCoordinateEarlier (x' : 𝒳) (a' : 𝒜) (x : 𝒳) (a : 𝒜) : Prop :=\n  x' < x ∨ (x' = x ∧ a' < a)\n\n/-- Lexicographic comparison of prediction vectors in the fixed sequential\ncontext-then-action order. -/\ndef PredictionLexLT (f g : Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)) : Prop :=\n  ∃ x a,\n    (∀ x' a', PredictionCoordinateEarlier x' a' x a → f x' a' = g x' a') ∧\n    f x a < g x a\n\n/-- Predicate characterizing the sequentially lexicographic ERM. -/\ndef IsLexicographicERM (sample : LoggedSample n 𝒳 𝒜)\n    (f : Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)) : Prop :=\n  f ∈ predictionPolytope E ∧\n  (∀ g ∈ predictionPolytope E, empiricalLoss sample f ≤ empiricalLoss sample g) ∧\n  ∀ g ∈ predictionPolytope E,\n    empiricalLoss sample g = empiricalLoss sample f → ¬ PredictionLexLT g f\n\n/-- Total noncomputable selection, using zero only in the logically unreachable\ncase in which the compact minimizer predicate has no witness. -/\nnoncomputable def selectedERM (sample : LoggedSample n 𝒳 𝒜) :\n    Prediction (𝒳 := 𝒳) (𝒜 := 𝒜) := by\n  classical\n  exact if h : ∃ f, IsLexicographicERM E sample f then Classical.choose h else fun _ _ => 0\n  -- @realizes \\widehat f(sequentially lexicographic empirical-risk minimizer)\n\n/-- Empirical logging seminorm squared. -/\nnoncomputable def empiricalSeminormSq (sample : LoggedSample n 𝒳 𝒜)\n    (h : Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)) : ℝ :=\n  (n : ℝ)⁻¹ * ∑ i, (h (sample i).context (sample i).action) ^ 2\n  -- @realizes \\|\\cdot\\|_n(empirical prediction seminorm)\n\n/-- Prediction confidence polytope. -/\ndef confidencePolytope (c0 : ℝ) (sample : LoggedSample n 𝒳 𝒜) :\n    Set (Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)) :=\n  {f | f ∈ predictionPolytope E ∧\n    empiricalSeminormSq sample (fun x a => f x a - selectedERM E sample x a) ≤\n      c0 * ((d : ℝ) * Real.log (Real.exp 1 * n) + Real.log (2 * (n : ℝ) ^ 2)) / n}\n  -- @realizes \\mathcal Q_n(empirical ball around fhat)\n\n/-- Coordinatewise lower envelope of the confidence polytope. -/\nnoncomputable def lowerEnvelope (c0 : ℝ) (sample : LoggedSample n 𝒳 𝒜) :\n    Prediction (𝒳 := 𝒳) (𝒜 := 𝒜) :=\n  fun x a => sInf {r : ℝ | ∃ f ∈ confidencePolytope E c0 sample, r = f x a}\n\n/-- Gibbs policy generated by the coordinatewise lower envelope. -/\nnoncomputable def lowerEnvelopePolicy (c0 : ℝ) (sample : LoggedSample n 𝒳 𝒜) :\n    Policy 𝒳 𝒜 :=\n  fun x a =>\n    E.reference x a * Real.exp (E.eta * lowerEnvelope E c0 sample x a) /\n      ∑ b, E.reference x b * Real.exp (E.eta * lowerEnvelope E c0 sample x b)\n  -- @realizes \\widehat\\pi(lower-envelope Gibbs learner; receives only D_n and 𝔈)\n\n/-- Diagnostic pessimistic empirical welfare criterion. -/\nnoncomputable def diagnosticPessimisticWelfare (c0 : ℝ)\n    (sample : LoggedSample n 𝒳 𝒜) (π : Policy 𝒳 𝒜)\n    (_hπ : IsPolicy π ∧ PolicySupportedOn π E.reference) : ℝ :=\n  sInf {j : ℝ | ∃ f ∈ confidencePolytope E c0 sample,\n    j = (n : ℝ)⁻¹ * ∑ i, ∑ a, π (sample i).context a * f (sample i).context a -\n      (E.eta * n)⁻¹ * ∑ i, policyKL π E.reference (sample i).context}\n  -- @realizes \\underline J_n(real-valued diagnostic restricted to\n  -- reference-supported policies in Δ(𝒜)^𝒳)\n\n/-- All components of the prediction-polytope learner. -/\nstructure PredictionPolytopeConstruction (n : ℕ) where\n  functionClass : Set (Prediction (𝒳 := 𝒳) (𝒜 := 𝒜))\n  loss : LoggedSample n 𝒳 𝒜 → Prediction (𝒳 := 𝒳) (𝒜 := 𝒜) → ℝ\n  selected : LoggedSample n 𝒳 𝒜 → Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)\n  seminormSq : LoggedSample n 𝒳 𝒜 → Prediction (𝒳 := 𝒳) (𝒜 := 𝒜) → ℝ\n  confidence : LoggedSample n 𝒳 𝒜 → Set (Prediction (𝒳 := 𝒳) (𝒜 := 𝒜))\n  lowerReward : LoggedSample n 𝒳 𝒜 → Prediction (𝒳 := 𝒳) (𝒜 := 𝒜)\n  deployed : Learner n (𝒳 := 𝒳) (𝒜 := 𝒜)\n  diagnostic : (sample : LoggedSample n 𝒳 𝒜) → (π : Policy 𝒳 𝒜) →\n    IsPolicy π ∧ PolicySupportedOn π E.reference → ℝ\n\n-- @node: def:prediction-polytope-learner\n/-- Complete prediction-polytope learner at universal radius constant `c₀`. -/\nnoncomputable def predictionPolytopeLearner (c0 : ℝ) (_hc0 : 0 < c0) :\n    PredictionPolytopeConstruction E n where\n  functionClass := predictionPolytope E\n  loss := empiricalLoss\n  selected := selectedERM E\n  seminormSq := empiricalSeminormSq\n  confidence := confidencePolytope E c0\n  lowerReward := lowerEnvelope E c0\n  deployed := fun sample _ => lowerEnvelopePolicy E c0 sample\n  diagnostic := diagnosticPessimisticWelfare E c0\n  -- @realizes c_0(carrier ℝ; universal positive/sufficiently-large range in upper theorems)\n\n/-- Finite-dimensional compact selection makes the concrete learner measurable. -/\nlemma predictionPolytopeLearner_measurable\n    (c0 : ℝ) (hc0 : 0 < c0) :\n    IsMeasurableLearner E\n      (predictionPolytopeLearner E c0 hc0 (n := n)).deployed := by\n  sorry\n\n/-- The lower-envelope Gibbs numerator vanishes exactly off reference\nsupport, so every deployed row is reference supported. -/\nlemma predictionPolytopeLearner_supported (c0 : ℝ) (hc0 : 0 < c0) :\n    ∀ sample hs,\n      PolicySupportedOn\n        ((predictionPolytopeLearner E c0 hc0 (n := n)).deployed sample hs)\n        E.reference := by\n  intro sample hs x a href\n  simp only [predictionPolytopeLearner, lowerEnvelopePolicy]\n  rw [href]\n  simp\n\n-- @node: def:erm-gibbs-plugin-learner\n/-- Gibbs plug-in learner generated by the selected ERM. -/\nnoncomputable def ermGibbsPluginLearner :\n    Learner n (𝒳 := 𝒳) (𝒜 := 𝒜) :=\n  fun sample _ x a =>\n    E.reference x a * Real.exp (E.eta * selectedERM E sample x a) /\n      ∑ b, E.reference x b * Real.exp (E.eta * selectedERM E sample x b)\n  -- @realizes \\widehat\\pi_{\\mathrm{ERM}}(Gibbs policy of fhat)\n\n/-- The ERM Gibbs plug-in has exactly the public reference support. -/\nlemma ermGibbsPluginLearner_supported :\n    ∀ sample hs,\n      PolicySupportedOn (ermGibbsPluginLearner (n := n) E sample hs) E.reference := by\n  intro sample hs x a href\n  simp only [ermGibbsPluginLearner]\n  rw [href]\n  simp\n\n/-- Finite-dimensional ERM selection and the continuous Gibbs map make the\nplug-in learner a member of the effective decision class. -/\nlemma ermGibbsPluginLearner_measurable :\n    IsMeasurableLearner E (ermGibbsPluginLearner (n := n) E) := by\n  sorry\n\n/-- `E'` is the invertible feature-coordinate reparameterization of `E`. -/\ndef IsFeatureReparameterization\n    (E' : CommonExperiment d 𝒳 𝒜) (T : (Matrix (Fin d) (Fin d) ℝ)ˣ) : Prop :=\n  (∀ x a, E'.feature x a = (T : Matrix (Fin d) (Fin d) ℝ).mulVec (E.feature x a)) ∧\n  E'.reference = E.reference ∧ E'.eta = E.eta\n  -- @realizes T(invertible GL_d(ℝ) feature reparameterization)\n\n-- @node: lem:learner-invariance\nlemma learner_invariance\n    (E' : CommonExperiment d 𝒳 𝒜) (T : (Matrix (Fin d) (Fin d) ℝ)ˣ)\n    (hT : IsFeatureReparameterization E E' T) (c0 : ℝ) :\n    predictionPolytope E' = predictionPolytope E ∧\n    selectedERM (n := n) E' = selectedERM (n := n) E ∧\n    confidencePolytope (n := n) E' c0 = confidencePolytope (n := n) E c0 ∧\n    (∀ sample π\n      (hπ' : IsPolicy π ∧ PolicySupportedOn π E'.reference)\n      (hπ : IsPolicy π ∧ PolicySupportedOn π E.reference),\n      diagnosticPessimisticWelfare (n := n) E' c0 sample π hπ' =\n        diagnosticPessimisticWelfare (n := n) E c0 sample π hπ) ∧\n    lowerEnvelopePolicy (n := n) E' c0 = lowerEnvelopePolicy (n := n) E c0 := by\n  rcases hT with ⟨hfeature, href, heta⟩\n  have hinvfeature : ∀ x a,\n      E.feature x a =\n        (↑T⁻¹ : Matrix (Fin d) (Fin d) ℝ).mulVec (E'.feature x a) := by\n    intro x a\n    rw [hfeature]\n    rw [Matrix.mulVec_mulVec, Units.inv_mul, Matrix.one_mulVec]\n  have hpoly : predictionPolytope E' = predictionPolytope E := by\n    ext f\n    constructor\n    · rintro ⟨hf, theta, htheta⟩\n      refine ⟨hf, (↑T : Matrix (Fin d) (Fin d) ℝ).transpose.mulVec theta, ?_⟩\n      intro x a\n      rw [htheta x a, hfeature x a]\n      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply]\n      simp_rw [Finset.sum_mul, Finset.mul_sum]\n      rw [Finset.sum_comm]\n      simp only [mul_comm, mul_left_comm]\n    · rintro ⟨hf, theta, htheta⟩\n      refine\n        ⟨hf, (↑T⁻¹ : Matrix (Fin d) (Fin d) ℝ).transpose.mulVec theta, ?_⟩\n      intro x a\n      rw [htheta x a, hinvfeature x a]\n      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply]\n      simp_rw [Finset.sum_mul, Finset.mul_sum]\n      rw [Finset.sum_comm]\n      simp only [mul_comm, mul_left_comm]\n  have hselected : selectedERM (n := n) E' = selectedERM (n := n) E := by\n    unfold selectedERM IsLexicographicERM\n    rw [hpoly]\n  have hconfidence :\n      confidencePolytope (n := n) E' c0 =\n        confidencePolytope (n := n) E c0 := by\n    unfold confidencePolytope\n    rw [hpoly, hselected]\n  refine ⟨hpoly, hselected, hconfidence, ?_, ?_⟩\n  · intro sample π hπ' hπ\n    unfold diagnosticPessimisticWelfare\n    rw [hconfidence, href, heta]\n  · unfold lowerEnvelopePolicy lowerEnvelope\n    rw [hconfidence, href, heta]\n\nend CausalSmith.Stat.ReverseKLTwoCoverage\n","exit_code":0,"status":"completed"}}
