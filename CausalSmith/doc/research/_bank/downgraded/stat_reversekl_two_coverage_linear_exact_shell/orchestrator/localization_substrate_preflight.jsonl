ormSquareComparison\",\n      \"kind\": \"Def\",\n      \"start_line\": 57,\n      \"end_line\": 57,\n      \"type_signature\": \": Prop\",\n      \"children\": []\n    },\n    {\n      \"name\": \"ProjectionNoiseConditions\",\n      \"kind\": \"Thm\",\n      \"start_line\": 79,\n      \"end_line\": 79,\n      \"type_signature\": \"{Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] (m : MeasurableSpace Ω) (hm : m ≤ mΩ) (eps : Fin n → Ω → ℝ) : Prop\",\n      \"children\": []\n    },\n    {\n      \"name\": \"ProjectorRankAtMost\",\n      \"kind\": \"Def\",\n      \"start_line\": 93,\n      \"end_line\": 93,\n      \"type_signature\": \"(Pi : Matrix (Fin n) (Fin n) ℝ) (r : ℕ) : Prop\",\n      \"children\": []\n    },\n    {\n      \"name\": \"bounded_projection_concentration\",\n      \"kind\": \"Thm\",\n      \"start_line\": 98,\n      \"end_line\": 98,\n      \"type_signature\": \"{Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] (m : MeasurableSpace Ω) (hm : m ≤ mΩ) (eps : Fin n → Ω → ℝ) (Pi : Ω → Matrix (Fin n) (Fin n) ℝ) (rankBound : ℕ) (zeta : ℝ) (hnoise : ProjectionNoiseConditions (mΩ\",\n      \"children\": []\n    },\n    {\n      \"name\": \"cellCount\",\n      \"kind\": \"Def\",\n      \"start_line\": 133,\n      \"end_line\": 133,\n      \"type_signature\": \"{m : ℕ} (sample : Fin (m ^ 2) → Fin m) (j : Fin m) : ℕ\",\n      \"children\": []\n    },\n    {\n      \"name\": \"multinomial_max_count\",\n      \"kind\": \"Thm\",\n      \"start_line\": 241,\n      \"end_line\": 241,\n      \"type_signature\": \"(m : ℕ) (hm : 0 < m) (μ : Measure (Fin m)) (hμ : IsProbabilityMeasure μ) (hunif : ∀ j, μ.real {j} = 1 / m) : (iidProduct μ hμ (m ^ 2)).real {sample | ∃ j, 3 * m < cellCount sample j} ≤ m * Real.exp (-(m : ℝ) * (3 * Real.log 3 - 2)) ∧ Filter.Tendsto (fun m : ℕ => (m : ℝ) * Real.exp (-(m : ℝ) * (3 * Real.log 3 - 2))) Filter.atTop (nhds 0)\",\n      \"children\": []\n    },\n    {\n      \"name\": \"linearReward_mem_predictionPolytope\",\n      \"kind\": \"Thm\",\n      \"start_line\": 388,\n      \"end_line\": 388,\n      \"type_signature\": \"(E : CommonExperiment d 𝒳 𝒜) (P : BanditLaw E) (C D : ℝ) (hshell : ExactShell E P C D) : linearReward P ∈ predictionPolytope E\",\n      \"children\": []\n    },\n    {\n      \"name\": \"empiricalSeminormSq_sub_triangle\",\n      \"kind\": \"Thm\",\n      \"start_line\": 397,\n      \"end_line\": 397,\n      \"type_signature\": \"(sample : LoggedSample n 𝒳 𝒜) (f g h : Prediction (𝒳\",\n      \"children\": []\n    },\n    {\n      \"name\": \"uniform_gibbs_radius_comparison\",\n      \"kind\": \"Thm\",\n      \"start_line\": 436,\n      \"end_line\": 436,\n      \"type_signature\": \"(E : CommonExperiment d 𝒳 𝒜) (rho : Measure 𝒳) (hrho : IsProbabilityMeasure rho) (zeta : ℝ) (hzeta : 0 < zeta) (hn : 0 < n) : (iidProduct rho hrho n).real {sample | ∀ g ∈ predictionPolytope E, ∀ f ∈ predictionPolytope E, (∫ x, gibbsRadius E g f x ∂rho) ≤ 2 * ((n : ℝ)⁻¹ * ∑ i, gibbsRadius E g f (sample i)) + gibbsRadiusRemainder d n E.eta zeta ∧ ((n : ℝ)⁻¹ * ∑ i, gibbsRadius E g f (sample i)) ≤ 2 * (∫ x, gibbsRadius E g f x ∂rho) + gibbsRadiusRemainder d n E.eta zeta} ≥ 1 - zeta\",\n      \"children\": []\n    },\n    {\n      \"name\": \"bounded_linear_localization\",\n      \"kind\": \"Thm\",\n      \"start_line\": 454,\n      \"end_line\": 454,\n      \"type_signature\": \"(E : CommonExperiment d 𝒳 𝒜) (P : BanditLaw E) (C D : ℝ) (hshell : ExactShell E P C D) (hZhao : ZhaoUniformSquareComparison (𝒳\",\n      \"children\": []\n    },\n    {\n      \"name\": \"MeasurableMaximumTheorem\",\n      \"kind\": \"Def\",\n      \"start_line\": 476,\n      \"end_line\": 476,\n      \"type_signature\": \": Prop\",\n      \"children\": []\n    }\n  ],\n  \"total_declarations\": null\n}"}],"structured_content":{"imports":["CausalSmith.Stat.STAT_ReverseklTwoCoverage_Research.Basic","CausalSmith.Stat.STAT_ReverseklT